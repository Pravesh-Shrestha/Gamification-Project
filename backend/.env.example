# academia.io - Server Environment Configuration
# Copy this file to .env and fill in the values.

# === Database ===
# PostgreSQL connection string (Prisma Data Platform pooled URL)
DATABASE_URL="postgresql://user:password@pooled.db.prisma.io:5432/postgres?sslmode=verify-full"
DIRECT_URL="postgresql://user:password@db.prisma.io:5432/postgres?sslmode=verify-full"

# === Authentication ===
# Generate a strong secret: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="your-strong-secret-here-change-me"

# === Server ===
PORT=3001
NODE_ENV="development"

# === CORS ===
# Frontend origin(s), comma-separated if multiple
CORS_ORIGIN="http://localhost:5173"
